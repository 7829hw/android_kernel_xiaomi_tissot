# Certificates for signature checking
CONFIG_SYSTEM_TRUSTED_KEYS=""

# Platform
CONFIG_MACH_XIAOMI_MSM8953=y
CONFIG_MACH_XIAOMI_TISSOT=y
# CONFIG_MACH_XIAOMI_TIFFANY is not set
# CONFIG_MACH_XIAOMI_MIDO is not set
# CONFIG_MACH_XIAOMI_DAISY is not set
# CONFIG_MACH_XIAOMI_SAKURA is not set
# CONFIG_MACH_XIAOMI_ROSY is not set
# CONFIG_MACH_XIAOMI_VINCE is not set
# CONFIG_MACH_XIAOMI_YSL is not set

# A/B partition support (tissot ships with seamless updates)

# CONFIG_SECURITY_SELINUX_BOOTPARAM is not set

# CONFIG_SECURITY_SELINUX_DEVELOP is not set
# Expose the normal Android init path for the A/B bootloader.
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y

# SCSI Transports
CONFIG_BLK_DEV_MD=y
CONFIG_MD_LINEAR=y
# CONFIG_DM_DEFAULT_KEY is not set
CONFIG_DM_ANDROID_VERITY=y

# CODEC drivers
CONFIG_SND_SOC_MAX98927=y

# Fingerprint
CONFIG_FINGERPRINT_FPC1020=y
CONFIG_FINGERPRINT_GOODIX_GF3208=y


# Only the Tissot DTB is emitted.
# CONFIG_MACH_XIAOMI_MARKW is not set
# CONFIG_BUILD_ARM64_DT_OVERLAY is not set
# CONFIG_MSMB_CAMERA_LEGACY_N is not set
CONFIG_USB_DWC3_MSM=y
# CONFIG_USB_DWC3_MSM_LEGACY is not set
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_CMDLINE="androidboot.hardware=qcom androidboot.bootdevice=7824900.sdhci androidboot.boot_devices=soc/7824900.sdhci"
CONFIG_CMDLINE_EXTEND=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Mi A1 uses Focaltech FT5435; the generic Android defaults enable other panels.
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_CORE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_TOUCH is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_DEVICE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_DIAGNOSTICS is not set

# SPI infrared transmitter.
CONFIG_SPI_PEELIR=y
